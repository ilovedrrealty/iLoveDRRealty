# Dashboard app (Vite + React SPA) — copy to `.env` (git-ignored) for local dev.
# Every VITE_* value is INLINED INTO THE BUNDLE AT BUILD TIME and is public.
# Never put a secret here. On Vercel, set these in Project Settings > Environment Variables
# and redeploy — changing them does not affect an already-built deployment.
# Full reference: docs/ENV.md

# Base URL of realty-api (axios, withCredentials). Falls back to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Landing site URL. The dashboard has no login page: unauthenticated users are sent to
# <VITE_LANDING_URL>/login, and logout / logo links go there too.
# Fallback if unset differs by file: App.tsx falls back to http://localhost:3000,
# other components fall back to https://ilovedrrealty.com — always set it explicitly.
VITE_LANDING_URL=http://localhost:3000

# Google OAuth 2.0 Web client ID (used for linking/unlinking a Google account in Settings).
# Same client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the landing app. Empty = Google features disabled.
VITE_GOOGLE_CLIENT_ID=
