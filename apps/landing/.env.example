# Landing app (Next.js 15, static export) — copy to `.env` (git-ignored) for local dev.
# Every NEXT_PUBLIC_* value is INLINED INTO THE BUNDLE AT BUILD TIME and is public.
# Never put a secret here. On Vercel, set these in Project Settings > Environment Variables
# and redeploy — changing them does not affect an already-built deployment.
# Full reference: docs/ENV.md

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of realty-api. Used by the browser (axios) AND at build time by
# generateStaticParams() / sitemap.ts to enumerate listings.
# If unset it falls back to http://localhost:8000 — a production build with this
# unset silently produces zero /listing/<id>/ pages and an empty listing sitemap.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Cross-app links ──────────────────────────────────────────────────────────
# Dashboard SPA URL (Navbar, login/signup/verify redirects).
# Falls back to https://app.ilovedrrealty.com if unset (NOT localhost).
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5174

# ── SEO ──────────────────────────────────────────────────────────────────────
# robots.txt is "Disallow: /" unless this is exactly `production`.
# Set to `production` ONLY on the production Vercel environment.
NEXT_PUBLIC_SITE_ENV=development

# ── Google ───────────────────────────────────────────────────────────────────
# OAuth 2.0 Web client ID (Google sign-in). Empty = Google button will not work.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Maps JavaScript API key (search map + property map). Restrict by HTTP referrer in Google Cloud.
# Empty = maps show a "missing key" placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── PayPal ───────────────────────────────────────────────────────────────────
# PayPal REST app *client ID* (public). Must belong to the same PayPal app and mode
# (sandbox/live) as PAYPAL_CLIENT_ID on the API. Only used when PAYPAL_ENABLED is true
# in src/lib/features.ts. Empty = PayPal checkout is hidden on rental listings.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
